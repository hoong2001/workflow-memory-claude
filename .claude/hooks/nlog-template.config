<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="c:\temp\nlog-internal.log">

  <!-- EventLog target ships inside core NLog.dll on .NET Framework; only Mail needs its
       extension package (NLog.Targets.Mail). Do NOT add NLog.Targets.EventLog here — the
       package is not referenced and the load failure shows up in the internal log. -->
  <extensions>
    <add assembly="NLog.Targets.Mail" />
  </extensions>

  <!-- Per-project values: the six variables below. Everything else is identical in every project. -->
  <variable name="logName"
            value="__LOG_NAME__" />
  <variable name="appName"
            value="__APP_NAME__" />
  <variable name="smtpServer"
            value="__SMTP_SERVER__" />
  <variable name="mailFrom"
            value="__MAIL_FROM__" />
  <variable name="mailTo"
            value="__MAIL_TO__" />
  <variable name="mailSubject"
            value="__MAIL_SUBJECT__" />

  <targets>

    <target name="eventlog"
            xsi:type="EventLog"
            layout="${level} | ${message} | ${exception:format=toString}"
            source="${appName}"
            log="${logName}"
            eventId="0"
            onOverflow="Truncate" />

    <target name="mail"
            xsi:type="Mail"
            layout="${level} | ${message} | ${exception:format=toString}"
            smtpServer="${smtpServer}"
            smtpPort="25"
            deliveryMethod="Network"
            from="${mailFrom}"
            to="${mailTo}"
            subject="${mailSubject}" />

  </targets>

  <rules>

    <logger  name="*"
             minlevel="Debug"
             writeTo="eventlog" />

    <logger  name="*"
             minlevel="Error"
             writeTo="mail" />

  </rules>
</nlog>
