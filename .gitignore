# Machine-local config (e.g. a skill's references/vault-path.local.json) - never committed.
*.local.json

# Ad-hoc task records (project-memory/tasks/) hold real business data - report
# queries, customer names, sample output - so they stay out of git. Only the
# convention file is committed.
project-memory/tasks/*
!project-memory/tasks/_README.md

# Master only - not in SYNC-MANIFEST's .gitignore row. Interviews run here test
# wp-idea-interview; a project commits its own interviews like its plans.
project-memory/interviews/
